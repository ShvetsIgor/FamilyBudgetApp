# Firebase — paste values from Firebase Console → Project Settings → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Sentry error monitoring (optional) — create a Next.js project at sentry.io
# and paste its DSN; leave empty to disable reporting entirely
NEXT_PUBLIC_SENTRY_DSN=

# Groq — AI expense parser (server-only, no NEXT_PUBLIC_ prefix).
# Never expose this to the browser bundle. Get a key at console.groq.com
GROQ_API_KEY=

# Optional service-wide ceiling on Groq calls across all accounts (positive
# integers; anything else falls back to the defaults 30/minute, 1000/day —
# Groq's free-tier REQUEST limits). Groq's token caps (~8K/minute, ~200K/day)
# usually bind first; its 429 Retry-After is then stored as a cooldown on
# aiUsage/global and no one calls Groq until it ends.
AI_GLOBAL_LIMIT_PER_MINUTE=
AI_GLOBAL_LIMIT_PER_DAY=

# Firebase Admin SDK (server-only) — Firebase Console → Project Settings →
# Service Accounts → Generate new private key.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# The downloaded JSON's `private_key` field, base64-encoded into ONE line —
# never paste the raw multi-line PEM here. A literal newline landing inside
# an unquoted .env value gets truncated by the parser instead of erroring
# loudly, which is worse than it sounds. See how to generate this value in
# chat (a one-off Node command against the downloaded service-account JSON).
FIREBASE_ADMIN_PRIVATE_KEY_BASE64=

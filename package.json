{
  "name": "family-budget-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:emulated": "NEXT_PUBLIC_USE_FIREBASE_EMULATOR=1 NEXT_PUBLIC_FIREBASE_API_KEY=demo-key NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-family-budget.firebaseapp.com NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-family-budget NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-family-budget.appspot.com NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000 NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore --project family-budget-rules-test \"vitest run --config vitest.rules.config.ts\"",
    "build:e2e-emulated": "NEXT_PUBLIC_USE_FIREBASE_EMULATOR=1 NEXT_PUBLIC_FIREBASE_API_KEY=demo-key NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-family-budget.firebaseapp.com NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-family-budget NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-family-budget.appspot.com NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000 NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo next build --webpack",
    "test:e2e:emulated": "npm run build:e2e-emulated && npx firebase-tools emulators:exec --only auth,firestore --project demo-family-budget \"playwright test --config playwright.emulated.config.ts\""
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@reduxjs/toolkit": "^2.11.2",
    "@sentry/nextjs": "^10.64.0",
    "@serwist/next": "^9.5.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.13.0",
    "lucide-react": "^1.14.0",
    "next": "^16.3.2",
    "next-intl": "^4.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.2.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.9.0",
    "eslint-config-next": "^16.3.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.0",
    "serwist": "^9.5.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}

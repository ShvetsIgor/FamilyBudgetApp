      "title": "How to use",
      "subtitle": "Chat → Tag → Section → Refine → Save",
      "tip1": {
        "title": "Type a merchant and amount",
        "desc": "The merchant becomes a tag and is saved verbatim. Just write where and how much",
        "example": "Dabbah 1000 · Coffee 80 · Taxi 350"
      },
      "tip2": {
        "title": "Pick a section once — it's remembered",
        "desc": "If the merchant is new, the bot will ask for a section. Next time Dabbah goes straight into Supermarket without asking",
        "example": "Dabbah → Supermarket"
      },
      "tip3": {
        "title": "Split a receipt by categories",
        "desc": "When a single receipt holds different things, split it inside the chosen section — the merchant tag stays on the card, categories show in detail",
        "example": "Dabbah 1000 → Groceries 700 + Home 300"
      },
      "tip4": {
        "title": "Undo delete",
        "desc": "After Delete you have 5 seconds to tap Undo and bring the expense back. Otherwise it is removed for good."
      },
      "tip5": {
        "title": "Date in chat",
        "desc": "Type the date together with the expense — \"tomorrow\", \"05.06\", \"June 5\", \"next week\". The expense will be saved for that date.",
        "example": "TV 15000 June 5"
      },
      "tip6": {
        "title": "Type + before amount for income",
        "desc": "+ at the start switches the entry to income. The bot will offer income sections and save the merchant as a source",
        "example": "+15000 Salary · +3000 Freelance"
      },
      "tip7": {
        "title": "Categories tab — library and cleanup",
        "desc": "Day-to-day everything happens in chat. The Categories tab is for editing the library, budgets and bulk cleanup",
        "example": "Edit · Budget · Reset"
      },
      "tip8": {
        "title": "Recurring payments",
        "desc": "Set rent, subscription or mortgage once — the app will remind you of the due date and show upcoming bills on Home",
        "example": "Netflix · Rent · Mortgage"
      }
